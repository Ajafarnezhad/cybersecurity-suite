# Copy to .env and fill in real values. Never commit a real .env file.

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

FLASK_DEBUG=false
LOG_LEVEL=INFO
LOG_DIR=logs
REPORTS_DIR=reports

# Root directory that /scan/static is allowed to analyze.
SCAN_ALLOWED_ROOT=.
SCAN_MAX_PORT_RANGE=1024
SCAN_SOCKET_TIMEOUT=0.5

ENABLE_CHAT_DEMO=false
CHAT_HOST=127.0.0.1
CHAT_PORT=8888
